# Coworking API configuration.

# Postgres connection string. On Railway, reference the Postgres plugin var:
#   DATABASE_URL=${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coworking

# HTTP port. Railway injects PORT automatically; this is the local default.
PORT=8080

# Run pending migrations on boot. Keep true on Railway so deploys self-migrate.
MIGRATE_ON_START=true

NODE_ENV=development

# Premium gating (billing deferred). Free workspaces are capped; a workspace with
# is_premium = true bypasses the caps. Set COWORKING_ENFORCE_LIMITS=false to disable.
COWORKING_ENFORCE_LIMITS=true
COWORKING_FREE_MAX_PROJECTS=3
COWORKING_FREE_MAX_TASKS_PER_PROJECT=100
