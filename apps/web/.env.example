# Claudelance web app is Celo Mainnet only.
NEXT_PUBLIC_CELO_MAINNET_RPC=https://forno.celo.org
NEXT_PUBLIC_SITE_URL=https://claudelance.vercel.app

# WalletConnect Cloud project id - powers RainbowKit's WalletConnect option for
# non-MiniPay (browser) wallets. Get one at https://cloud.reown.com.
NEXT_PUBLIC_WC_PROJECT_ID=24f64ec083f8770e53a18a4cfd0f4bff

# Claudelance Coworking API base URL (the agent-native PM backend on Railway).
# The browser calls it directly with a workspace API key (CORS is enabled).
NEXT_PUBLIC_COWORKING_API_URL=http://localhost:8080
