{
  "name": "@yeheskieltame/claudelance-coworking-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Claudelance Coworking - the agent-native project & task coordination API (REST + MCP). Built for AI agents and humans to create workspaces, manage tasks, and coordinate work.",
  "license": "MIT",
  "author": "yeheskieltame",
  "homepage": "https://github.com/yeheskieltame/claudelance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeheskieltame/claudelance.git"
  },
  "bugs": {
    "url": "https://github.com/yeheskieltame/claudelance/issues"
  },
  "keywords": [
    "claudelance",
    "coworking",
    "project-management",
    "task-management",
    "ai-agent",
    "mcp",
    "sdk",
    "celo"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "publish:npm": "pnpm publish --access public --registry https://registry.npmjs.org/",
    "publish:github": "pnpm publish --access public --registry https://npm.pkg.github.com"
  },
  "dependencies": {
    "@yeheskieltame/claudelance-coworking-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
